# Raspberry Pi bridge agent config (rename to bridge.env in private/)
CHARGER_HOST=192.168.0.145

# Path to the Firebase service-account key (relative to repo root or absolute)
FIREBASE_SERVICE_ACCOUNT=private/service-account.json

# Optional tuning (seconds)
STATUS_INTERVAL=10
CONFIG_INTERVAL=60
SCHEDULE_INTERVAL=60
SCHEDULE_RECONCILE_INTERVAL=300
COMMAND_INTERVAL=5

# Watchdog: restart a charger that stops answering /status (see pi/README.md).
# Defaults shown; remove a line to keep the default.
WATCHDOG_ENABLED=true
WATCHDOG_FAILURES=3
WATCHDOG_COOLDOWN_SEC=600
WATCHDOG_MAX_PER_HOUR=3
WATCHDOG_RESTART_WHILE_CHARGING=false

# MQTT status ingestion (issue #44). Off by default: with MQTT_ENABLED=false the
# bridge polls HTTP exactly as before. Keep the broker password here only.
# MQTT_ENABLED=true
# MQTT_HOST=192.168.0.224
# MQTT_PORT=1883
# MQTT_USER=chelevse
# MQTT_PASS=<broker password>
# MQTT_TOPIC=chelevse
# MQTT_RECONCILE_SEC=60
# MQTT_CLIENT_ID=chelevse-bridge
# Announce/Last Will filter the watchdog reads (default shown)
# MQTT_ANNOUNCE_TOPIC="openevse/announce/#"
