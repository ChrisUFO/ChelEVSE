{
  "name": "chelevse",
  "private": true,
  "version": "0.1.0",
  "description": "OpenEVSE -> Firebase bridge and PWA. Dev tooling only; the app itself has no build step.",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/web/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-chelevse \"node --test test/rules/*.test.js\"",
    "prepare": "git config core.hooksPath .githooks || true",
    "deploy": "firebase deploy --project \"$FIREBASE_PROJECT\"",
    "deploy:dry-run": "firebase deploy --dry-run --project \"$FIREBASE_PROJECT\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project \"$FIREBASE_PROJECT\"",
    "deploy:indexes": "firebase deploy --only firestore:indexes --project \"$FIREBASE_PROJECT\"",
    "deploy:hosting": "firebase deploy --only hosting --project \"$FIREBASE_PROJECT\"",
    "predeploy": "node scripts/check-firebase-project.mjs",
    "predeploy:dry-run": "node scripts/check-firebase-project.mjs",
    "predeploy:rules": "node scripts/check-firebase-project.mjs",
    "predeploy:indexes": "node scripts/check-firebase-project.mjs",
    "predeploy:hosting": "node scripts/check-firebase-project.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "10.12.2",
    "firebase-tools": "^15.34.0",
    "prettier": "^3.3.3"
  }
}
