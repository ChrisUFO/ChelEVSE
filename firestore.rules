rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Access grant: the owner creates users/<uid> = {allowed: true} in the
    // Firebase console to allowlist a signed-in Google account. All data
    // access below requires this grant (plus a verified email).
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowed == true;
    }

    // Users can read their own grant doc (so the app can show a proper
    // "no access" state instead of a generic failure).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // owner grants via console / Admin SDK only
    }

    // Charger status + config: written only by the bridge (Admin SDK bypasses
    // rules), readable by allowlisted users.
    match /status/{doc} {
      allow read: if allowed();
      allow write: if false;
    }

    // Energy history: bridge-written, allowlisted users read.
    match /history/{day} {
      allow read: if allowed();
      allow write: if false;
    }
    match /sessions/{id} {
      allow read: if allowed();
      allow write: if false;
    }

    // Charge schedule: the one client-writable doc — allowlisted users.
    // Firestore rules cannot iterate a list, and per-element validation of the
    // 20-rule array trips the 1000-expression evaluation limit at 4 rules, so
    // rules validate the document container only. Per-rule shape is
    // re-validated by the bridge, which skips and logs malformed rules; the
    // app-side check lands with the schedule screen.
    match /schedule/{doc} {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.data.keys().hasOnly(['enabled', 'rules'])
        && request.resource.data.enabled is bool
        && request.resource.data.rules is list
        && request.resource.data.rules.size() <= 20;
    }

    // App settings: client-writable by allowlisted users, shape-validated.
    // The flat rate/currency stay mandatory; `rates` (the optional
    // time-of-use/seasonal schedule, with the flat rate as its fallback) may be
    // absent. Rules cannot iterate a list, so the guard is container-only:
    // list, at most 24 rows — the same limit and reasoning as the schedule.
    // Per-window shape and overlaps are validated by web/js/rates.js before
    // the write is attempted.
    match /settings/{doc} {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.rate <= 5
        && request.resource.data.currency is string
        && request.resource.data.currency.size() >= 1
        && request.resource.data.currency.size() <= 8
        && (
             !request.resource.data.keys().hasAny(['rates'])
             || (
                  request.resource.data.rates is list
                  && request.resource.data.rates.size() <= 24
                )
           );
    }

    // FCM push registrations: users manage only their own token docs. The doc
    // shape is pinned (uid + created_at only — the bridge honours `token`, so an
    // update must not be able to rewrite it). Create and update require the
    // access grant, so a de-allowlisted account cannot register; delete only
    // requires ownership, so revoking access can still release the device (see
    // the delete clause).
    match /fcmTokens/{token} {
      allow read: if false;
      allow create: if allowed()
        && request.resource.data.keys().hasOnly(['uid', 'created_at'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at is timestamp;
      allow update: if allowed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'created_at'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at is timestamp;
      // A release retry may find the doc already gone (the first delete
      // succeeded but its acknowledgement was lost); deleting a missing doc is
      // a no-op and must not fail the retry.
      //
      // Delete deliberately does not require the access grant: revoking access
      // must not also trap the device's registration, or the bridge keeps
      // pushing the old account's charging alerts. An authenticated owner can
      // always remove its own doc.
      allow delete: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Commands: allowlisted users may create whitelisted, validated commands;
    // lifecycle (ack/fail/delete) belongs to the bridge only.
    // 'rapi' is the advanced escape hatch — RAPI commands start with '$'.
    match /commands/{cmd} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.status == 'pending'
        && (
             (request.resource.data.type == 'pause')
          || (request.resource.data.type == 'resume')
          || (request.resource.data.type == 'set_current'
              && request.resource.data.amps is number
              && request.resource.data.amps >= 6
              && request.resource.data.amps <= 48)
          // RAPI commands start with a literal '$' (character class avoids
          // escaping ambiguity); the 32-char cap bounds what reaches the bridge.
          || (request.resource.data.type == 'rapi'
              && request.resource.data.command is string
              && request.resource.data.command.matches('^[$][A-Za-z0-9]{1,2}([ ].*)?$')
              && request.resource.data.command.size() <= 32)
        );
      allow update, delete: if false;
    }
  }
}
