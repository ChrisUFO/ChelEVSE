rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Access grant: the owner creates users/<uid> = {allowed: true} in the
    // Firebase console to allowlist a signed-in Google account. All data
    // access below requires this grant (plus a verified email).
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowed == true;
    }

    // Users can read their own grant doc (so the app can show a proper
    // "no access" state instead of a generic failure).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // owner grants via console / Admin SDK only
    }

    // Charger status + config: written only by the bridge (Admin SDK bypasses
    // rules), readable by allowlisted users.
    match /status/{doc} {
      allow read: if allowed();
      allow write: if false;
    }

    // Energy history: bridge-written, allowlisted users read.
    match /history/{day} {
      allow read: if allowed();
      allow write: if false;
    }
    match /sessions/{id} {
      allow read: if allowed();
      allow write: if false;
    }

    // Charge schedule: the one client-writable doc — allowlisted users.
    // The Rules language has no lambda/iteration, so a rule map is validated by
    // a helper and each possible list index is checked explicitly (max 20).
    function valid_schedule_rule(r) {
      return r is map
        && r.keys().hasOnly(['id', 'days', 'start', 'end', 'amps'])
        && r.id is string
        && r.id.size() >= 1
        && r.id.size() <= 64
        && r.days is list
        && r.days.size() >= 1
        && r.days.size() <= 7
        && (r.days.size() < 1 || (r.days[0] is int && r.days[0] >= 0 && r.days[0] <= 6))
        && (r.days.size() < 2 || (r.days[1] is int && r.days[1] >= 0 && r.days[1] <= 6))
        && (r.days.size() < 3 || (r.days[2] is int && r.days[2] >= 0 && r.days[2] <= 6))
        && (r.days.size() < 4 || (r.days[3] is int && r.days[3] >= 0 && r.days[3] <= 6))
        && (r.days.size() < 5 || (r.days[4] is int && r.days[4] >= 0 && r.days[4] <= 6))
        && (r.days.size() < 6 || (r.days[5] is int && r.days[5] >= 0 && r.days[5] <= 6))
        && (r.days.size() < 7 || (r.days[6] is int && r.days[6] >= 0 && r.days[6] <= 6))
        && r.start is string
        && r.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && r.end is string
        && r.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && r.start != r.end
        && r.amps is number
        && r.amps >= 6
        && r.amps <= 48;
    }

    match /schedule/{doc} {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.data.keys().hasOnly(['enabled', 'rules'])
        && request.resource.data.enabled is bool
        && request.resource.data.rules is list
        && request.resource.data.rules.size() <= 20
        && (request.resource.data.rules.size() < 1 || valid_schedule_rule(request.resource.data.rules[0]))
        && (request.resource.data.rules.size() < 2 || valid_schedule_rule(request.resource.data.rules[1]))
        && (request.resource.data.rules.size() < 3 || valid_schedule_rule(request.resource.data.rules[2]))
        && (request.resource.data.rules.size() < 4 || valid_schedule_rule(request.resource.data.rules[3]))
        && (request.resource.data.rules.size() < 5 || valid_schedule_rule(request.resource.data.rules[4]))
        && (request.resource.data.rules.size() < 6 || valid_schedule_rule(request.resource.data.rules[5]))
        && (request.resource.data.rules.size() < 7 || valid_schedule_rule(request.resource.data.rules[6]))
        && (request.resource.data.rules.size() < 8 || valid_schedule_rule(request.resource.data.rules[7]))
        && (request.resource.data.rules.size() < 9 || valid_schedule_rule(request.resource.data.rules[8]))
        && (request.resource.data.rules.size() < 10 || valid_schedule_rule(request.resource.data.rules[9]))
        && (request.resource.data.rules.size() < 11 || valid_schedule_rule(request.resource.data.rules[10]))
        && (request.resource.data.rules.size() < 12 || valid_schedule_rule(request.resource.data.rules[11]))
        && (request.resource.data.rules.size() < 13 || valid_schedule_rule(request.resource.data.rules[12]))
        && (request.resource.data.rules.size() < 14 || valid_schedule_rule(request.resource.data.rules[13]))
        && (request.resource.data.rules.size() < 15 || valid_schedule_rule(request.resource.data.rules[14]))
        && (request.resource.data.rules.size() < 16 || valid_schedule_rule(request.resource.data.rules[15]))
        && (request.resource.data.rules.size() < 17 || valid_schedule_rule(request.resource.data.rules[16]))
        && (request.resource.data.rules.size() < 18 || valid_schedule_rule(request.resource.data.rules[17]))
        && (request.resource.data.rules.size() < 19 || valid_schedule_rule(request.resource.data.rules[18]))
        && (request.resource.data.rules.size() < 20 || valid_schedule_rule(request.resource.data.rules[19]));
    }

    // App settings: client-writable by allowlisted users, shape-validated.
    match /settings/{doc} {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.rate <= 5
        && request.resource.data.currency is string
        && request.resource.data.currency.size() >= 1
        && request.resource.data.currency.size() <= 8;
    }

    // FCM push registrations: users manage only their own token docs.
    match /fcmTokens/{token} {
      allow read: if false;
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Commands: allowlisted users may create whitelisted, validated commands;
    // lifecycle (ack/fail/delete) belongs to the bridge only.
    // 'rapi' is the advanced escape hatch — RAPI commands start with '$'.
    match /commands/{cmd} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.status == 'pending'
        && (
             (request.resource.data.type == 'pause')
          || (request.resource.data.type == 'resume')
          || (request.resource.data.type == 'set_current'
              && request.resource.data.amps is number
              && request.resource.data.amps >= 6
              && request.resource.data.amps <= 48)
          // RAPI commands start with a literal '$' (character class avoids
          // escaping ambiguity); the 32-char cap bounds what reaches the bridge.
          || (request.resource.data.type == 'rapi'
              && request.resource.data.command is string
              && request.resource.data.command.matches('^[$][A-Za-z0-9]{1,2}([ ].*)?$')
              && request.resource.data.command.size() <= 32)
        );
      allow update, delete: if false;
    }
  }
}
