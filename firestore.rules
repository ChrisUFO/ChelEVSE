rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Charger status: written only by the bridge (Admin SDK bypasses rules),
    // readable by the authenticated owner.
    match /status/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Commands: the app may create whitelisted, validated commands;
    // lifecycle (ack/fail/delete) belongs to the bridge only.
    match /commands/{cmd} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.type in ['pause', 'resume', 'set_current']
        && request.resource.data.status == 'pending'
        && (request.resource.data.type != 'set_current'
            || (request.resource.data.amps is number
                && request.resource.data.amps >= 6
                && request.resource.data.amps <= 48));
      allow update, delete: if false;
    }
  }
}
