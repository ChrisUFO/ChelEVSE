rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Access grant: the owner creates users/<uid> = {allowed: true} in the
    // Firebase console to allowlist a signed-in Google account. All data
    // access below requires this grant (plus a verified email).
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowed == true;
    }

    // Users can read their own grant doc (so the app can show a proper
    // "no access" state instead of a generic failure).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // owner grants via console / Admin SDK only
    }

    // Charger status + config: written only by the bridge (Admin SDK bypasses
    // rules), readable by allowlisted users.
    match /status/{doc} {
      allow read: if allowed();
      allow write: if false;
    }

    // Energy history: bridge-written, allowlisted users read.
    match /history/{day} {
      allow read: if allowed();
      allow write: if false;
    }
    match /sessions/{id} {
      allow read: if allowed();
      allow write: if false;
    }

    // Charge schedule: the one client-writable doc — allowlisted users,
    // shape-validated. The bridge reads it and enforces it on the charger.
    match /schedule/{doc} {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.data.enabled is bool
        && request.resource.data.rules is list
        && request.resource.data.rules.size() <= 20
        && request.resource.data.rules.all(r => r is map
              && r.days is list && r.days.size() >= 1
              && r.days.all(d => d is int && d >= 0 && d <= 6)
              && r.start is string && r.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
              && r.end is string && r.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
              && r.amps is number && r.amps >= 6 && r.amps <= 48);
    }

    // App settings: client-writable by allowlisted users, shape-validated.
    match /settings/{doc} {
      allow read: if allowed();
      allow write: if allowed()
        && request.resource.data.rate is number
        && request.resource.data.rate >= 0
        && request.resource.data.rate <= 5
        && request.resource.data.currency is string
        && request.resource.data.currency.size() >= 1
        && request.resource.data.currency.size() <= 8;
    }

    // FCM push registrations: users manage only their own token docs.
    match /fcmTokens/{token} {
      allow read: if false;
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Commands: allowlisted users may create whitelisted, validated commands;
    // lifecycle (ack/fail/delete) belongs to the bridge only.
    // 'rapi' is the advanced escape hatch — RAPI commands start with '$'.
    match /commands/{cmd} {
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.status == 'pending'
        && (
             (request.resource.data.type == 'pause')
          || (request.resource.data.type == 'resume')
          || (request.resource.data.type == 'set_current'
              && request.resource.data.amps is number
              && request.resource.data.amps >= 6
              && request.resource.data.amps <= 48)
          || (request.resource.data.type == 'rapi'
              && request.resource.data.command is string
              && request.resource.data.command.matches('^$[A-Za-z0-9]{1,2}([ ].*)?$')
              && request.resource.data.command.size() <= 32)
        );
      allow update, delete: if false;
    }
  }
}
